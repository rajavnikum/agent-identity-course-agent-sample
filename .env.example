# -----------------------------------------------------------------------------
# Local app
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=replace-with-random-secret
ALLOW_LOCAL_UNSIGNED_JWT=false

# -----------------------------------------------------------------------------
# Optional LLM
# USE_LLM=true uses Gemini for intent classification.
# USE_LLM=false uses deterministic fallback parsing.
# -----------------------------------------------------------------------------
USE_LLM=true
GEMINI_API_KEY=<your-new-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# IBM Verify tenant / authorization server endpoints
# Example issuer: https://your-tenant.verify.ibm.com/oauth2
# -----------------------------------------------------------------------------
VERIFY_ISSUER=https://<tenant>/oauth2
VERIFY_AUTHORIZATION_ENDPOINT=https://<tenant>/oauth2/authorize
VERIFY_TOKEN_ENDPOINT=https://<tenant>/oauth2/token
VERIFY_JWKS_URI=https://<tenant>/oauth2/jwks
VERIFY_INTROSPECTION_ENDPOINT=https://<tenant>/oauth2/introspect

# -----------------------------------------------------------------------------
# Subject client - human user login by Authorization Code + PKCE
# -----------------------------------------------------------------------------
SUBJECT_CLIENT_ID=<course-chat-ui-client-id>
SUBJECT_CLIENT_SECRET=<course-chat-ui-client-secret>
SUBJECT_REDIRECT_URI=http://localhost:8000/callback
SUBJECT_SCOPES=openid profile email course.read course.enroll

# -----------------------------------------------------------------------------
# Actor client - registered AI agent runtime identity
# -----------------------------------------------------------------------------
ACTOR_CLIENT_ID=<course-assistant-agent-client-id>
ACTOR_CLIENT_SECRET=<course-assistant-agent-client-secret>
ACTOR_SCOPES=agent.run

# -----------------------------------------------------------------------------
# STS client - OAuth 2.0 Token Exchange client
# IMPORTANT: must request both read and enroll scopes for this demo.
# -----------------------------------------------------------------------------
STS_CLIENT_ID=<course-agent-sts-client-id>
STS_CLIENT_SECRET=<course-agent-sts-client-secret>
STS_REQUESTED_SCOPE=course.read course.enroll

# -----------------------------------------------------------------------------
# Verify Directory / SCIM lookup client
# Use a separate API/management client that can read users from Verify Directory.
# This is used only when the target is not self, e.g. "rick".
# -----------------------------------------------------------------------------
VERIFY_MANAGEMENT_CLIENT_ID=<verify-management-client-id>
VERIFY_MANAGEMENT_CLIENT_SECRET=<verify-management-client-secret>
VERIFY_MANAGEMENT_SCOPES=

# -----------------------------------------------------------------------------
# RAR / ADT
# -----------------------------------------------------------------------------
AGENT_ADT_TYPE=urn:ibm:demo:verify:agent_action
COURSE_API_AUDIENCE=course-api
