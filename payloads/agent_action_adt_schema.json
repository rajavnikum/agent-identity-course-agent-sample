{
  "description": "Agent action authorization details for the IBM Verify conversational AI direct tools sample",
  "type": "object",
  "required": [
    "type",
    "courseId",
    "operationDetails"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "urn:ibm:demo:verify:agent_action"
    },
    "courseId": {
      "type": "string"
    },
    "operationDetails": {
      "type": "object",
      "required": [
        "creator",
        "affectedPerson",
        "loggedInSubject",
        "action",
        "targetSystem",
        "resource"
      ],
      "additionalProperties": false,
      "properties": {
        "creator": {
          "type": "string"
        },
        "affectedPerson": {
          "type": "string"
        },
        "loggedInSubject": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "list_available_courses",
            "list_enrolled_courses",
            "enroll_course"
          ]
        },
        "targetSystem": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      }
    }
  }
}